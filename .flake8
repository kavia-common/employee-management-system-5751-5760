[flake8]
# Keep lines readable but within reasonable limits
max-line-length = 120

# Align with common formatting preferences
extend-ignore = E203, W503

# Exclude virtual environments, cache, VCS, and generated artifacts
exclude =
    .git,
    __pycache__,
    .venv,
    */.venv/*,
    venv,
    env,
    build,
    dist,
    .pytest_cache,
    employee_backend/.venv,
    employee_backend/interfaces/openapi.json,
    employee_backend/alembic/versions/*

# Relax import/unused checks in package initializers (often intentionally empty or import side-effectful)
per-file-ignores =
    employee_backend/src/**/__init__.py: F401,F403
