# Example environment variables for Employee Backend (do NOT commit real secrets)

# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Database
# For local development, SQLite is fine; for production use a managed RDBMS connection string
DATABASE_URL=sqlite:///./employees.db

# JWT configuration (REQUIRED)
# Generate a secure random string (e.g., `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional CORS settings if env-driven CORS is re-enabled
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# SQLAlchemy debug echo (0/1)
SQLALCHEMY_ECHO=0
