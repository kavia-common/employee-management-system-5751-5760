# Example environment variables for Employee Backend (FastAPI)
# Copy this file to .env and set values appropriate for your environment.

# Application environment
ENV=development
LOG_LEVEL=INFO

# Database
# For local development, SQLite is convenient:
DATABASE_URL=sqlite:///./employees.db
# For Postgres example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# JWT configuration (REQUIRED)
# IMPORTANT: Set JWT_SECRET to a secure, random string in real environments.
# The application fails fast at startup if this is not set properly.
JWT_SECRET=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional SQLAlchemy echo (debug)
# SQLALCHEMY_ECHO=0

# Optional CORS origins (production use). The app currently uses hardcoded origins in src/api/main.py
# CORS_ORIGINS=["http://localhost:3000","https://your-frontend.example.com"]
