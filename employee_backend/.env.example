# Employee Backend - .env.example
# Copy this file to `.env` and replace placeholder values with secure, environment-specific values.
# DO NOT commit your `.env` file to version control.

# Environment metadata
ENV=development
LOG_LEVEL=INFO

# Database configuration
# For local development, SQLite is the default (no external DB service needed).
# For other environments, set a proper RDBMS connection string (e.g., PostgreSQL).
DATABASE_URL=sqlite:///./employees.db
# Set to 1 to echo SQL statements (debugging only)
SQLALCHEMY_ECHO=0
# Pool settings for non-SQLite databases
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security / JWT
# REQUIRED: Set a secure, random secret in all non-test environments.
# Example: Use `openssl rand -hex 32` to generate a strong value.
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
# Default algorithm; do not change unless you know what you're doing.
JWT_ALGORITHM=HS256
# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration
# NOTE: For development, CORS allowlist is hardcoded in src/api/main.py to support preview/local frontends.
# For production, uncomment and set as a JSON array or CSV list, and re-enable env-driven CORS in code.
#CORS_ORIGINS=["https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000","https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3002","http://localhost:3000","http://localhost:3002"]
# or
#CORS_ORIGINS=https://example.com,https://admin.example.com

# Alembic / Migrations
# Migrations are applied at startup if core tables are missing. For reliability in production,
# run explicitly during deployment: `alembic upgrade head`.
