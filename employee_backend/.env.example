# Employee Backend - Environment Variables Example
#
# Copy this file to `.env` and set the values for your environment.
# Do NOT commit secrets. The orchestrator will set environment variables in CI/CD.
#
# Notes:
# - DATABASE_URL: For local dev, SQLite is fine (e.g., sqlite:///./employees.db).
# - JWT_SECRET: MUST be set to a secure random value in production.
# - CORS: Currently hardcoded allowlist is used in src/api/main.py for preview/local.
#         In production, set CORS_ORIGINS and update main.py to use env-driven config.

# Environment metadata
ENV=development
LOG_LEVEL=INFO

# Database configuration
# SQLite (local dev)
DATABASE_URL=sqlite:///./employees.db
# Example for Postgres (uncomment and configure):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# SQLAlchemy optional settings (only used for non-SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Log SQL statements (0/1)
SQLALCHEMY_ECHO=0

# Security / JWT
# IMPORTANT: Set a secure random secret in deployment (do not use the placeholder).
JWT_SECRET=PLEASE_SET_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (currently not used; CORS is hard-coded in src/api/main.py)
# Use either JSON array or CSV list if re-enabled:
# CORS_ORIGINS=["http://localhost:3000","https://your-preview.example.com:3000"]
# or
# CORS_ORIGINS=http://localhost:3000,https://your-preview.example.com:3000

# Trusted hosts (optional; if re-enabled with TrustedHostMiddleware)
# TRUSTED_HOSTS=["localhost","127.0.0.1"]
# or
# TRUSTED_HOSTS=localhost,127.0.0.1
