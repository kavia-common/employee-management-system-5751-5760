# Database connection string
# Examples:
# - SQLite (local development): sqlite:///./employees.db
# - PostgreSQL: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# - MySQL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///./employees.db

# SQLAlchemy connection pool configuration (applies to non-SQLite DBs)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
