# Employee Backend - Environment Variables Example
# Copy this file to ".env" and replace placeholder values with your environment-specific configuration.
# SECURITY: Never commit your real .env with secrets to version control.

# -----------------------------------------------------------------------------
# Application / Environment
# -----------------------------------------------------------------------------
ENV=development                 # "development" | "production"
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For local development, SQLite is sufficient; for higher environments use Postgres/MySQL.
# SQLite example (relative path): sqlite:///./employees.db
# Postgres example: postgresql+psycopg2://user:password@host:5432/employees
# MySQL example: mysql+pymysql://user:password@host:3306/employees
DATABASE_URL=sqlite:///./employees.db

# Optional SQLAlchemy tuning (non-SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=0               # 1 to enable SQL echo for debugging

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
# REQUIRED: Set a secure, random secret (e.g., 32+ chars). Do NOT use the default.
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60  # Token lifetime in minutes

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Note: CORS is currently hardcoded in src/api/main.py to allow preview/local origins.
# For production, re-enable env-driven CORS and set CORS_ORIGINS accordingly.
# Supported formats:
# - JSON array: '["https://a","http://b:3000"]'
# - CSV: 'https://a,http://b:3000'
CORS_ORIGINS=["https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000","https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3002","http://localhost:3000","http://localhost:3002"]

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - Run migrations before starting the API: `alembic upgrade head`
# - Start server: `uvicorn src.api.main:app --reload --host 0.0.0.0 --port 3001`
# - Do NOT log or expose credentials/tokens. Use HTTPS in production.
