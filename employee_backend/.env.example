# Employee Backend - Environment Variables Example
#
# Copy this file to ".env" and set values as appropriate for your environment.
# Do NOT commit your real secrets to source control.
#
# Notes:
# - For local development, SQLite is used by default; you can override to Postgres/MySQL as needed.
# - JWT_SECRET must be set to a strong, random value in all environments.
# - CORS origins are currently hardcoded in src/api/main.py for preview/local ports (3000/3002).
#   For production, switch back to env-driven CORS using CORS_ORIGINS.

# -----------------------------------------------------------------------------
# Environment / Logging
# -----------------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
# Enable SQLAlchemy engine echo logs for debugging (0 or 1)
SQLALCHEMY_ECHO=0

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development default: SQLite file in project root
# Example for SQLite:
DATABASE_URL=sqlite:///./employees.db

# Example for Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME

# Optional pooling settings (applied for non-SQLite engines)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------------------------------
# REQUIRED: Set a strong random value in real environments
JWT_SECRET=CHANGE_ME_IN_ENV
# Algorithm used to sign tokens (default HS256)
JWT_ALGORITHM=HS256
# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CORS (Production usage)
# -----------------------------------------------------------------------------
# CORS_ORIGINS accepts JSON array or CSV form
# Example (JSON array):
# CORS_ORIGINS=["https://your-frontend.example.com","http://localhost:3000"]
# Example (CSV):
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000
# Currently hardcoded in src/api/main.py for preview/local origins; keep blank or configure when re-enabled.
CORS_ORIGINS=
