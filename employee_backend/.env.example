# Employee Backend - Environment Variables Template
# Copy this file to ".env" and customize values for your environment.
# IMPORTANT: Never commit your real .env with secrets to source control.

# -----------------------------------------------------------------------------
# General Environment
# -----------------------------------------------------------------------------
# ENV can be "development" or "production"
ENV=development
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Example for local dev using SQLite (file will be created next to the app)
DATABASE_URL=sqlite:///./employees.db
# SQLAlchemy engine debug logging (0 or 1)
SQLALCHEMY_ECHO=0
# Pooling options (used for non-SQLite engines)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Security - JWT
# -----------------------------------------------------------------------------
# REQUIRED: Set a secure, random secret for JWT signing (e.g., 32+ chars).
# Example to generate (Linux/macOS):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=PLEASE_SET_A_SECURE_RANDOM_VALUE
# JWT signing algorithm
JWT_ALGORITHM=HS256
# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Allowed origins as a JSON array or comma-separated list (framework supports both).
# Note: Current app has a fixed allowlist in src/api/main.py as requested; this setting
# remains for production readiness if env-driven CORS is re-enabled.
CORS_ORIGINS=["https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000","https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3002","http://localhost:3000","http://localhost:3002"]
