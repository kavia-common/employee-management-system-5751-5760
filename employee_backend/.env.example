# Employee Backend - Example Environment Configuration
# Copy this file to ".env" and set values appropriate for your environment.
# WARNING: Do NOT commit real secrets to source control.

# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Database configuration
# For local development using SQLite:
DATABASE_URL=sqlite:///./employees.db
# For other DBs, use the appropriate SQLAlchemy URL (e.g., PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/employees

# SQLAlchemy options (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Set to "1" to enable SQL query echo (verbose):
SQLALCHEMY_ECHO=0

# JWT configuration (required)
# Set a strong, random secret for signing JWTs in all environments.
JWT_SECRET=CHANGE_ME_IN_ENV
# Algorithm to use for signing JWTs:
JWT_ALGORITHM=HS256
# Access token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (optional; in code a fixed allowlist is used for preview/local by default)
# Supports JSON array or CSV; examples below:
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Trusted hosts (optional; not enforced by default in this project configuration)
# TRUSTED_HOSTS=["localhost","127.0.0.1"]
# TRUSTED_HOSTS=localhost,127.0.0.1
