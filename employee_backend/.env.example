# Employee Backend - Environment Variables Example
# Copy this file to ".env" and set appropriate values for your environment.
# Do NOT commit your real .env to source control.

# Environment metadata
ENV=development
LOG_LEVEL=INFO

# Database configuration
# For local development, SQLite is used by default:
# sqlite:///./employees.db (relative file path)
DATABASE_URL=sqlite:///./employees.db

# SQLAlchemy options (non-SQLite)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# SQLALCHEMY_ECHO=0

# JWT / Auth configuration
# IMPORTANT: Set a strong random value for JWT_SECRET in real environments.
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration
# You can specify a JSON array or a comma-separated list of allowed origins, e.g.:
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]
# or
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Note: CORS is currently hardcoded in src/api/main.py to allow preview/local origins.
# For production, switch to env-driven configuration.
# CORS_ORIGINS=

# Trusted hosts (optional; CSV or JSON array). Use "*" only for development.
# TRUSTED_HOSTS=["example.com","api.example.com"]
# TRUSTED_HOSTS=*

