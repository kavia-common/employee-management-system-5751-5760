# Example environment configuration for Employee Backend (Do NOT commit real secrets)
# Copy to .env and adjust values for your environment.

# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Database configuration
# Default uses a local SQLite file in the project directory.
# For Postgres or MySQL, set an appropriate URL (e.g., postgresql+psycopg2://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./employees.db

# Security (JWT)
# IMPORTANT: Replace with a strong, random secret in real environments.
JWT_SECRET=REPLACE_WITH_SECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (optional; app uses a fixed allowlist in src/api/main for preview/local)
# Example: ["http://localhost:3000","http://localhost:3002"]
CORS_ORIGINS=[]

# SQLAlchemy debugging (optional)
SQLALCHEMY_ECHO=0

# Connection pooling for non-SQLite databases (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Development-only seed flag (optional)
# If set to "true" in development, seeds sample employees when empty
SEED_ON_STARTUP=true
