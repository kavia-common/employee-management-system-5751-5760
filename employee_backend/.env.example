# Employee Backend - .env.example
# Copy this file to .env and update values for your environment.
# Never commit real secrets to version control.

# Environment metadata
ENV=development
LOG_LEVEL=INFO

# Database
# For local development, SQLite is convenient. For production, use a managed RDBMS.
# Examples:
#   sqlite:///./employees.db
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./employees.db

# Security - JWT
# REQUIRED: Set a strong random secret in your real environment (not this example).
# Algorithm defaults to HS256 unless overridden.
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# Optional when using the hardcoded CORS allowlist in src/api/main.py for preview/local.
# You can re-enable env-driven CORS by wiring settings.cors_origins.
# Formats supported:
#   JSON array: ["https://a", "http://localhost:3000"]
#   CSV: https://a,http://localhost:3000
# CORS_ORIGINS=["https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000","https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3002","http://localhost:3000","http://localhost:3002"]

# SQLAlchemy (debugging)
# Set to 1 to enable SQL echo logs (development only).
SQLALCHEMY_ECHO=0

# DB Pooling (non-SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
