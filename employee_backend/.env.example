# Example environment variables for Employee Backend (FastAPI)

# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///./employees.db

# JWT configuration (set a secure random value in real .env)
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration
# Preferred: set a CSV or JSON array of allowed origins.
# Example CSV:
# CORS_ORIGINS=http://localhost:3000,https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000
# Example JSON:
# CORS_ORIGINS=["http://localhost:3000","https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000"]
CORS_ORIGINS=

# Alternatively, set single FRONTEND_ORIGIN (also supports CSV/JSON)
# FRONTEND_ORIGIN=http://localhost:3000

# Trusted hosts (CSV or JSON array). In development, wildcard is allowed by default.
# TRUSTED_HOSTS=*

# Optional hints to derive frontend from backend origin (:3001 -> :3000)
# BACKEND_ORIGIN=https://your-hostname:3001
# API_BASE_URL=https://your-hostname:3001
# BACKEND_BASE_URL=https://your-hostname:3001
# EXTERNAL_URL=https://your-hostname:3001

# SQLAlchemy debug echo (0 or 1)
SQLALCHEMY_ECHO=0
