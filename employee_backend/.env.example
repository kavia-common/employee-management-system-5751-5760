# Example environment configuration for Employee Backend (FastAPI)
# Copy this file to ".env" and set values appropriate for your environment.
# Do NOT commit real secrets.

# Application environment
ENV=development
LOG_LEVEL=INFO

# Database
# For local development, SQLite is acceptable; for higher envs, use PostgreSQL/MySQL.
# Examples:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/employees
# DATABASE_URL=mysql+pymysql://user:password@host:3306/employees
DATABASE_URL=sqlite:///./employees.db

# Security - REQUIRED
# Set to a strong, random value. Never use the placeholder in production.
JWT_SECRET=CHANGE_ME_IN_ENV
# JWT signing algorithm (HS256 recommended for shared-secret setups)
JWT_ALGORITHM=HS256
# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (optional if hardcoded in src/api/main.py for dev)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# SQLAlchemy debug echo (0/1)
SQLALCHEMY_ECHO=0

# Optional DB pool settings for non-SQLite databases
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
