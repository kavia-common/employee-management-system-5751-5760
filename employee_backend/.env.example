# Example environment configuration for Employee Backend (FastAPI)

# Environment: development | production
ENV=development

# Logging level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Database connection (default dev uses SQLite local file)
DATABASE_URL=sqlite:///./employees.db

# JWT settings (MUST set a secure secret for non-dev)
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated or JSON array)
# Default safe values allow preview and local dev via React on port 3000.
# You may override this in deployment environments.
ALLOWED_ORIGINS=https://vscode-internal-23063-beta.beta01.cloud.kavia.ai:3000,http://localhost:3000

# Optional: seed demo employees on startup (dev only)
SEED_ON_STARTUP=true
