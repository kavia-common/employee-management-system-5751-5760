# Example environment variables for Employee Backend (FastAPI)
# Copy this file to ".env" and set values appropriately for your environment.

# Application environment
ENV=development
LOG_LEVEL=INFO

# Database configuration
# For local development (SQLite file):
DATABASE_URL=sqlite:///./employees.db
# For Postgres (example):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME

# SQLAlchemy debug echo (0|1)
SQLALCHEMY_ECHO=0

# Security / JWT (MUST set JWT_SECRET to a secure random value in real environments)
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (currently hardcoded in app for preview/local).
# When moving to env-driven CORS, provide a JSON array or CSV list:
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:3002", "https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000", "https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3002"]

# Frontend configuration note:
# In the frontend container, set REACT_APP_API_BASE_URL to this backend's URL on port 3002 for local/dev:
# REACT_APP_API_BASE_URL=http://localhost:3002

# Development seed data
# In development, seed sample employees on startup if table empty (default: true in dev)
# SEED_ON_STARTUP=true
