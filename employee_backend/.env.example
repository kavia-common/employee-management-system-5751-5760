# Environment configuration for Employee Backend

# Application environment: development | production
ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Database connection string
# For local development, SQLite file is convenient:
DATABASE_URL=sqlite:///./employees.db

# JWT configuration (required - set a secure random secret in your real .env)
JWT_SECRET=PLEASE_SET_A_SECURE_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated list)
# Include your exact frontend origin(s). Example below includes local React dev and the provided preview URL.
CORS_ORIGINS=http://localhost:3000,https://vscode-internal-19668-beta.beta01.cloud.kavia.ai:3000
