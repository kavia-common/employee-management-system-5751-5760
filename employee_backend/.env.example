# Employee Backend - Environment Configuration Example
# Copy this file to ".env" and replace placeholder values as needed.
# Do NOT commit your real .env with secrets.

# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Database (SQLite recommended for local dev)
# For SQLite: sqlite:///./employees.db
# For Postgres: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///./employees.db

# Security - JWT
# IMPORTANT: Set a secure random value for JWT_SECRET in real environments.
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLAlchemy options (mostly for non-SQLite databases)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=0

# CORS
# Note: For this project, allowed origins are hardcoded in src/api/main.py to support preview/local.
# When moving to production, consider re-enabling env-driven CORS via this variable and updating main.py.
# Supported formats: JSON array or comma-separated list.
# Example JSON: ["https://your-frontend.example.com","http://localhost:3000"]
# Example CSV: https://your-frontend.example.com,http://localhost:3000
CORS_ORIGINS=

# Trusted hosts (optional; for production hardening if re-enabled)
# TRUSTED_HOSTS=["your-backend.example.com"]

# Notes:
# - After setting up .env, run: alembic upgrade head
# - Start API: uvicorn src.api.main:app --reload --host 0.0.0.0 --port 3001
# - Ensure your frontend Origin matches allowed origins in src/api/main.py or CORS_ORIGINS once re-enabled.
