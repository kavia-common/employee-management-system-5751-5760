# Employee Backend - Example Environment Configuration
#
# Copy this file to ".env" and adjust values for your environment.
# DO NOT commit real secrets. These values are for local development only.

# Environment metadata
ENV=development
LOG_LEVEL=INFO

# Database configuration
# For local development: SQLite file in project directory
DATABASE_URL=sqlite:///./employees.db

# SQLAlchemy engine tuning (non-SQLite only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
SQLALCHEMY_ECHO=0

# JWT configuration
# IMPORTANT: Set a secure, random secret in real environments.
JWT_SECRET=PLEASE_SET_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (for production, if moving away from hardcoded list)
# Supports JSON array or comma-separated list. Example JSON array:
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# Dev-only seed switch: in development, the app may seed sample employees if empty.
# Set to "false" to disable seeding; default behavior seeds in development.
SEED_ON_STARTUP=true
