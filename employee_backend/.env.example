# Example environment variables for local development.
# Copy this file to ".env" and adjust values as needed.

# Environment
ENV=development
LOG_LEVEL=INFO

# Database (SQLite by default for dev)
DATABASE_URL=sqlite:///./employees.db

# Security - YOU MUST set a strong secret in production.
# The app will log a warning and start in development if this is missing,
# but do not rely on defaults for any deployed environment.
JWT_SECRET=please_change_me_to_a_strong_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: Seed sample employees on startup (dev-only recommended)
SEED_ON_STARTUP=true

# CORS origins (if you re-enable env-driven CORS)
#CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]
