# Employee Backend - Environment Variables (development defaults)

# Environment
ENV=development
LOG_LEVEL=INFO

# Database
# For local development, SQLite is simplest (file created in backend folder)
# Example: sqlite:///./employees.db
# For Postgres: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./employees.db

# JWT Auth
# IMPORTANT: Replace this with a secure, random value in real environments
JWT_SECRET=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# Comma-separated list of allowed origins. Example local dev origins:
# http://localhost:3000,https://your-frontend-preview.example.com
# If omitted AND ENV=development, backend allows "*" for dev convenience.
CORS_ORIGINS=http://localhost:3000
